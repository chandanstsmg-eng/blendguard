# BlendGuard configuration.
# On first start this file is copied to .env and every __generate__ below is
# replaced with a random value. Edit .env, not this file.

# Web address port. Station PCs open https://<server-name>:PORT (or http://
# before a certificate is set up; see docs/DEPLOYMENT.md).
PORT=4300

# HTTPS. Needed for fingerprint / face sign-in across the plant network.
# scripts/make-certificate.ps1 creates the certificate and fills these in.
# TLS_PFX=data/tls/blendguard.pfx
# TLS_PFX_PASSWORD=
# (or PEM files instead:  TLS_CERT=...  TLS_KEY=...)

# Plant time zone: shift reports and "today" follow it.
PLANT_TIMEZONE=Asia/Kolkata

# Database backups (data/backups): every night at this hour, kept this many days.
# BACKUP_COPY_TO puts a second copy on another disk or a network share; set it.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
# BACKUP_COPY_TO=\\fileserver\blendguard-backups

# First start with an empty database: SEED_DEMO=1 loads demo users and jobs
# (training PCs only). Otherwise a single "scientist" account is created and its
# password written to data/FIRST-SIGN-IN.txt.
SEED_DEMO=0

# Spoken instructions are played from recorded clips and never leave the plant.
# VOICE_ONLINE=1 would allow Microsoft's online voice as well: not for production.
VOICE_ONLINE=0

# Built-in database (PostgreSQL runs from the data/ folder, nothing to install).
PG_PORT=54339
PG_PASSWORD=__generate__

# To use your own PostgreSQL server instead, set DATABASE_URL and the built-in
# database will not be started.
# DATABASE_URL=postgresql://user:password@localhost:5432/blendguard

# Signs sessions and scientist sign-offs. Keep it secret.
SESSION_SECRET=__generate__

# Fingerprint / face sign-in (WebAuthn). RP ID must be the host name operators
# open in the browser (localhost, or the server's DNS name when using https).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:4300

# Demo accounts' credentials: used only when demo data is loaded (SEED_DEMO=1
# or `npm run reset-demo`). A live plant never has these accounts. The
# "scientist" and "scientist2" demo accounts (passwords below) are both scientists.
DEMO_SUPERVISOR_PASSWORD=Supervisor@2026
DEMO_ADMIN_PASSWORD=Admin@2026
DEMO_OPERATOR_PIN=2580

# Letterhead on batch records (PDF) and printed activity logs.
# Separate address lines with |. A logo at public/company-logo.png (PNG) is
# printed top right when present.
COMPANY_NAME=Synthite Ind. Pvt. Ltd
COMPANY_ADDRESS=Synthite Valley, Kolenchery, Cochin|Kerala 682311, India
COMPANY_DOC_NO=SYN/PRN-001/B
