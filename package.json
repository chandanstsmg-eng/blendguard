{
  "name": "blendguard",
  "version": "0.1.0",
  "private": true,
  "description": "BlendGuard — perfume manufacturing operator guidance and precision weighing. One app, one command.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx server/index.ts --dev",
