    "db:stop": "tsx scripts/db-stop.ts",
    "prisma": "tsx scripts/prisma.ts",
    "reset-demo": "tsx scripts/reset-demo.ts",
    "backup": "tsx scripts/backup.ts",
    "restore-backup": "tsx scripts/restore-backup.ts",
    "scale-bridge": "tsx scripts/scale-bridge.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests-web.json --noEmit",
